# Edge Function secrets for local `supabase functions serve`.
# Copy the complete "Basic ..." authorization value from PayHero API credentials.
PAYHERO_AUTHORIZATION=Basic replace-with-payhero-basic-auth-token
# Numeric payment channel ID from PayHero.
CHANNEL_ID=replace-with-payhero-channel-id
# Use your Supabase project's callback endpoint and a cryptographically random key of 32+ characters.
CALLBACK_URL=https://your-project.supabase.co/functions/v1/payhero-callback?key=replace-with-a-long-random-secret
