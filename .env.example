VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# PayHero Edge Function secrets (server-side only; do not prefix with VITE_)
# Copy the complete "Basic ..." authorization value from PayHero API credentials.
PAYHERO_AUTHORIZATION=
# Numeric payment channel ID from PayHero.
CHANNEL_ID=
CALLBACK_URL=https://your-project.supabase.co/functions/v1/payhero-callback?key=replace-with-a-long-random-secret
